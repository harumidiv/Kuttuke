    "小さい順に並べ、矢印か長押しドラッグで並べ替え" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Od nejmenšího; pořadí měňte šipkami nebo přetažením"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mindste først. Ændr rækkefølge med pile eller træk"
