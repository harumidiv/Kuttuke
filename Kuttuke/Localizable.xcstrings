    "%@で使われています。削除するとこれらのステージから外れ、設定した進化音も消えます。" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Používá se v: %@. Po smazání zmizí z těchto etap a nastavený zvuk evoluce se odstraní."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruges i %@. Hvis du sletter det, fjernes det fra disse baner, og dets evolutionslyd slettes også."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird in %@ verwendet. Beim Löschen wird es aus diesen Stages entfernt, samt eingestellter Evo-Sounds."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used in %@. Deleting it removes it from these stages, along with any evolution sounds you set."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se usa en %@. Si lo eliminas, se quitará de estas fases y también se borrará su sonido de evolución."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käytössä: %@. Poistettaessa se poistuu näistä kentistä ja sen kehitysääni poistetaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisé dans %@. Si tu le supprimes, il sera retiré de ces tableaux et son son d'évolution sera effacé."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dipakai di %@. Jika dihapus, item ini dilepas dari stage tersebut dan suara evolusinya juga hilang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usato in %@. Se lo elimini, verrà tolto da queste fasi e anche il suo suono di evoluzione verrà cancellato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@で使われています。削除するとこれらのステージから外れ、設定した進化音も消えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에서 사용 중입니다. 삭제하면 이 스테이지들에서 빠지고, 설정한 진화음도 사라집니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digunakan dalam %@. Jika dipadam, item ini dikeluarkan daripada pentas tersebut dan bunyi evolusinya juga hilang."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brukes i %@. Hvis du sletter det, fjernes det fra disse brettene, og evolusjonslyden slettes også."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruikt in %@. Bij verwijderen verdwijnt het uit deze stages, samen met ingestelde evolutiegeluiden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Używany w: %@. Po usunięciu zniknie z tych etapów, a ustawiony dźwięk ewolucji zostanie usunięty."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usado em %@. Se apagar, ele sai dessas fases e o som de evolução também será apagado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используется в: %@. После удаления элемент пропадёт из этих этапов, а его звук эволюции удалится."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Används i %@. Om du raderar det tas det bort från dessa banor och dess evolutionsljud raderas också."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kullanıldığı yerler: %@. Silerseniz bu bölümlerden çıkarılır ve evrim sesi de silinir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Використовується в: %@. Після видалення елемент зникне з цих етапів, а його звук еволюції буде видалено."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đang dùng trong %@. Nếu xóa, mục này sẽ bị gỡ khỏi các màn đó và âm tiến hóa đã đặt cũng mất."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@正在使用。刪除後會從這些關卡中移除，設定的進化音效也會消失。"
          }
        }
      }
    },
    "%@は素材が%lld個未満になり、遊べなくなります。" : {
      "localizations" : {
        "cs" : {
          "variations" : {
            "plural" : {
              "few" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%@: bude mít méně než %lld prvky a nepůjde hrát."
                }
              },
              "many" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%@: bude mít méně než %lld prvku a nepůjde hrát."
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%@: bude mít méně než %lld prvek a nepůjde hrát."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%@: bude mít méně než %lld prvků a nepůjde hrát."
                }
              }
            }
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ får færre end %lld objekter og kan ikke spilles."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat dann weniger als %lld Teile und ist nicht spielbar."
