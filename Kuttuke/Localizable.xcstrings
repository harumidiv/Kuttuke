    "マイクへのアクセスが許可されていません。設定アプリの「Kuttuke」からマイクを許可してください。" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přístup k mikrofonu není povolen. Povolte ho v aplikaci Nastavení > „Kuttuke“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appen har ikke adgang til mikrofonen. Tillad mikrofonen under »Kuttuke« i Indstillinger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein Mikrofonzugriff. Erlaube ihn unter „Einstellungen“ > „Kuttuke“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Microphone access isn’t allowed. Go to Settings > Kuttuke and turn on Microphone."
          }
