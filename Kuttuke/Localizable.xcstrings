    "光った被写体を下の枠へ運び「完了」で保存します" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přeneste zvýrazněný objekt do rámečku dole a klepněte na „Hotovo“"
