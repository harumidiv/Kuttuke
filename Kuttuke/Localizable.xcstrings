    "光ったら、そのまま指を離さず下へ動かします" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Až se objekt rozsvítí, nepouštějte prst a táhněte dolů"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når det lyser, træk ned uden at slippe"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn es leuchtet, ohne Loslassen nach unten ziehen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When it glows, drag it down without letting go"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando brille, arrástralo hacia abajo sin soltar"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun kohde hehkuu, vedä alas irrottamatta"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand il brille, glisse-le vers le bas sans lever le doigt"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat bersinar, geser ke bawah tanpa melepas jari"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando si illumina, trascinalo giù senza sollevare il dito"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "光ったら、そのまま指を離さず下へ動かします"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "빛나면 손가락을 떼지 말고 그대로 아래로 옮기세요"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apabila bercahaya, gerakkan ke bawah tanpa melepaskan jari"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når det lyser, dra ned uten å slippe"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als het oplicht, sleep het omlaag zonder los te laten"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy obiekt się podświetli, nie puszczaj i przesuń w dół"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando brilhar, arraste para baixo sem soltar"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда объект засветится, не отпуская палец, ведите вниз"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När det lyser, dra nedåt utan att släppa"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parlayınca parmağınızı kaldırmadan aşağı sürükleyin"
